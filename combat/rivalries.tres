kind = 1
character_a = &"tromp"
character_b = &"kim_jong_dos"
damage_multiplier = 0.75
activation_range = 12.0
line_a = "Kim, mi botón es más grande que el tuyo."
line_b = "El mío brilla. Mirá... ups."

[sub_resource type="Resource" id="r3"]
