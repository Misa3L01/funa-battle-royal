[ext_resource type="Script" path="res://combat/rivalry_data.gd" id="2_data"]

[sub_resource type="Resource" id="r0"]
script = ExtResource("2_data")
display_name = "La Grieta"
kind = 0
character_a = &"pilei"
character_b = &"birchner"
damage_multiplier = 1.25
activation_range = 12.0
line_a = "¡Viva la libertad, carajo! Y vos... ¡AFUERA!"
line_b = "Tomá nota, querido: esto termina en cadena nacional."

[sub_resource type="Resource" id="r1"]
script = ExtResource("2_data")
display_name = "Revancha Electoral"
kind = 0
character_a = &"tromp"
character_b = &"joe_bidet"
damage_multiplier = 1.25
activation_range = 12.0
line_a = "¡Fraude! ¡Esta pelea está arreglada!"
line_b = "Escuchame, jack... ¿quién sos vos?"

[sub_resource type="Resource" id="r2"]
script = ExtResource("2_data")
